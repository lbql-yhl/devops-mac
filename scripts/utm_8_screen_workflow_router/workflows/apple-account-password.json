{
  "name": "apple-account-password",
  "steps": [
    {
      "name": "open-apple-account",
      "template": "../templates/apple-account.png",
      "verify_template": "../templates/sign-in-security.png",
      "threshold": 0.6,
      "scales": [1, 2],
      "match_mode": "edges",
      "click": true,
      "wait_after_click_seconds": 3
    },
    {
      "name": "open-sign-in-and-security",
      "template": "../templates/sign-in-security.png",
      "verify_template": "../templates/change-password.png",
      "threshold": 0.6,
      "scales": [1, 2],
      "match_mode": "edges",
      "click": true,
      "wait_after_click_seconds": 3
    },
    {
      "name": "open-change-password",
      "template": "../templates/change-password.png",
      "verify_template": null,
      "threshold": 0.6,
      "scales": [1, 2],
      "match_mode": "edges",
      "click": true,
      "wait_after_click_seconds": 3
    }
  ]
}
