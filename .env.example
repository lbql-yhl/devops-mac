# Copy to .env and fill the real values from Feishu Open Platform.
SUBMISSION_GUEST_PASSWORD=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# Required for inventory report delivery and reserved from workflow routing.
FEISHU_DAILY_REPORT_CHAT_ID=

# Notion API. The root page is the current host-machine page that directly contains 模板.
NOTION_TOKEN=
NOTION_ROOT_PAGE_ID=
NOTION_TEMPLATE_TITLE=模板

# Exact Feishu Wiki Base source used by utm-notion.
UTM_NOTION_FEISHU_WIKI_URL=
UTM_NOTION_FEISHU_APP_TOKEN=
UTM_NOTION_FEISHU_TABLE_ID=
UTM_NOTION_FEISHU_VIEW_ID=

# Local HTTP service.
FEISHU_BOT_HOST=0.0.0.0
FEISHU_BOT_PORT=8787
SUBMISSION_HOST_MACHINE=
FEISHU_SEND_RETRIES=3
FEISHU_SEND_TIMEOUT_SECONDS=20
FEISHU_VERIFY_DELIVERY=1
USER_CONFIRM_API_URL=http://127.0.0.1:8000/confirm
USER_CONFIRM_API_TIMEOUT_SECONDS=3600

# Optional Feishu controls.
FEISHU_ALLOWED_CHAT_ID=
FEISHU_POLL_CHAT_IDS=
FEISHU_POLL_INTERVAL_SECONDS=15

# Long-connection mode avoids changing public callback URLs.
FEISHU_WS_ENABLED=1
FEISHU_TUNNEL_ENABLED=0
# Safe default: do not probe a public tunnel endpoint.
FEISHU_PUBLIC_HEALTH_CHECK=0
# Optional cloudflared executable override; blank resolves it through PATH.
CLOUDFLARED_BIN=
CLOUDFLARED_PROTOCOL=http2

# Assistant replies in Feishu.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
FEISHU_ASSISTANT_PROVIDER=codex
FEISHU_ASSISTANT_ENABLED=1
FEISHU_ASSISTANT_REQUIRE_MENTION=1
FEISHU_ASSISTANT_MAX_OUTPUT_TOKENS=800
# Resolve Codex through PATH; never copy another host's absolute binary path.
FEISHU_CODEX_COMMAND=codex
FEISHU_CODEX_MODEL=gpt-5.6-sol
FEISHU_CODEX_TIMEOUT_SECONDS=180

# Feishu intake creates a Codex App handoff and must not start a background runner.
SUBMISSION_RUNNER_COMMAND=
SUBMISSION_RUNNER_TIMEOUT_SECONDS=21600

# Portable host paths. Blank values use project/$HOME defaults.
SUBMISSION_PROJECT_ROOT=
SUBMISSION_VM_IMAGES_DIR=
SUBMISSION_VM_TEMPLATE=
SUBMISSION_SHARED_DIR=
PROJECT_SKILLS_DIR=

# Required by utm-21; values stay only in this host-local .env.
CODEUP_USERNAME=
CODEUP_PASSWORD=
